{
  "uid": "chaos-lab",
  "title": "Chaos Lab - Resilience",
  "tags": ["chaos", "kubernetes"],
  "timezone": "browser",
  "schemaVersion": 39,
  "version": 1,
  "refresh": "5s",
  "time": { "from": "now-15m", "to": "now" },
  "panels": [
    {
      "id": 1,
      "type": "timeseries",
      "title": "Request rate by component",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 0 },
      "fieldConfig": { "defaults": { "unit": "reqps" }, "overrides": [] },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (component) (rate(chaoslab_http_requests_total[1m]))",
          "legendFormat": "{{component}}"
        }
      ]
    },
    {
      "id": 2,
      "type": "timeseries",
      "title": "Checkout error ratio",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 0 },
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "min": 0,
          "max": 1,
          "color": { "mode": "fixed", "fixedColor": "red" }
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "expr": "(sum(rate(chaoslab_http_requests_total{component=\"frontend\",path=\"/checkout\",status=~\"5..\"}[1m])) or vector(0)) / sum(rate(chaoslab_http_requests_total{component=\"frontend\",path=\"/checkout\"}[1m]))",
          "legendFormat": "5xx ratio"
        }
      ]
    },
    {
      "id": 3,
      "type": "timeseries",
      "title": "Checkout latency (p50 / p95 / p99)",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 8 },
      "fieldConfig": { "defaults": { "unit": "s" }, "overrides": [] },
      "targets": [
        {
          "refId": "A",
          "expr": "histogram_quantile(0.50, sum by (le) (rate(chaoslab_http_request_duration_seconds_bucket{component=\"frontend\",path=\"/checkout\"}[1m])))",
          "legendFormat": "p50"
        },
        {
          "refId": "B",
          "expr": "histogram_quantile(0.95, sum by (le) (rate(chaoslab_http_request_duration_seconds_bucket{component=\"frontend\",path=\"/checkout\"}[1m])))",
          "legendFormat": "p95"
        },
        {
          "refId": "C",
          "expr": "histogram_quantile(0.99, sum by (le) (rate(chaoslab_http_request_duration_seconds_bucket{component=\"frontend\",path=\"/checkout\"}[1m])))",
          "legendFormat": "p99"
        }
      ]
    },
    {
      "id": 4,
      "type": "timeseries",
      "title": "Available vs desired replicas",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 8 },
      "fieldConfig": { "defaults": { "unit": "none", "min": 0 }, "overrides": [] },
      "targets": [
        {
          "refId": "A",
          "expr": "kube_deployment_status_replicas_available{namespace=\"shop\"}",
          "legendFormat": "{{deployment}} available"
        },
        {
          "refId": "B",
          "expr": "kube_deployment_spec_replicas{namespace=\"shop\"}",
          "legendFormat": "{{deployment}} desired"
        }
      ]
    },
    {
      "id": 5,
      "type": "timeseries",
      "title": "Upstream errors by reason",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 16 },
      "fieldConfig": { "defaults": { "unit": "ops" }, "overrides": [] },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (component, reason) (rate(chaoslab_upstream_errors_total[1m]))",
          "legendFormat": "{{component}} {{reason}}"
        }
      ]
    },
    {
      "id": 6,
      "type": "table",
      "title": "Firing alerts",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 16 },
      "fieldConfig": { "defaults": {}, "overrides": [] },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (alertname, severity) (ALERTS{alertstate=\"firing\",alertname!~\"Watchdog|InfoInhibitor\"})",
          "format": "table",
          "instant": true
        }
      ]
    }
  ]
}
